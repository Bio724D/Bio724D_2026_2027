library(palmerpenguins)
#| eval: true
#| output: false
penguins <- read_csv("~/Bio724/penguins.csv")
penguins |> slice(10)
penguins |> slice(10L)
penguins |>
slice(-(5:n()-5))
penguins |>
slice(-(5:n()))
penguins |>
slice(-(5:(n()-5))
)
penguins |>
slice(-c(2,4,6))
penguins |>
slice(-c(2,4,6)) |> head()
penguins |> head()
#| output: false
# get first six rows
penguins |>
slice_head(n=6)
# get last 10 rows
penguins |>
slice_tail(n=10)
# get a random sample of rows
penguins |>
slice_sample(n = 10)
