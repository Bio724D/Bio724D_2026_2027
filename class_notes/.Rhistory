# get only species and "bill" columns from penguin data
select(penguins, "sex", "age")
View(penguins)
# get only species and "bill" columns from penguin data
select(penguins, "sex", "year")
# get only species and "bill" columns from penguin data
select(penguins, "year", "sex")
# get everything except "bill" columns from penguins
select(penguins, !"year")
# get everything except "bill" columns from penguins
select(penguins, -"year")
# get everything except "bill" columns from penguins
select(penguins, !"year", !"age")
# get everything except "bill" columns from penguins
select(penguins, !"year", !"sex")
# get everything except "bill" columns from penguins
select(penguins, !c("year","sex"))
# get everything except "bill" columns from penguins
#select(penguins, !c("year","sex"))
select(penguins, starts_with("bill_"))
# get everything except "bill" columns from penguins
#select(penguins, !c("year","sex"))
select(penguins, is.numeric())
# get everything except "bill" columns from penguins
#select(penguins, !c("year","sex"))
select(penguins, where(is.numeric))
# get only the rows representing Gentoo penguins
filter(penguins, sex == "female")
# get only the rows representing Gentoo penguins
filter(penguins, sex == "female", year == 2007)
# get only the rows representing Gentoo penguins
filter(penguins, sex == "female", year = 2007)
# get only the rows representing Gentoo penguins
filter(penguins, sex == "female", year == 2007)
# exclude the rows that are Gentoo penguins
filter(penguins, sex != "female")
# get the Gentoo penguins bigger than 4.5 kg
filter(penguins, sex == "female", body_mass_g > 4500)
# create a derived column, body_mass_kg, in penguins
mutate(penguins, body_mass_kg = body_mass_g/1000)
View(penguins)
# create a derived column, body_mass_kg, in penguins
new_penguins <- mutate(penguins, body_mass_kg = body_mass_g/1000)
View(penguins)
View(new_penguins)
# create a derived column, body_mass_kg, in penguins
penguins <- mutate(penguins, body_mass_kg = body_mass_g/1000)
# sort penguins by bill_length_mm
arrange(penguins, body_mass_g)
# sort penguins by bill_length_mm
arrange(penguins, body_mass_g, year)
# sort penguins by bill_length_mm
arrange(penguins, desc(body_mass_g), year)
# sort penguins by bill_length_mm
arrange(penguins, desc(body_mass_g), year) |> head(n=10)
# sort penguins by bill_length_mm
arrange(penguins, desc(body_mass_g), year) |> head(n=5)
