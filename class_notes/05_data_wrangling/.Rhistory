library(tidyverse)
small <- read_csv("~/Bio724/small-messy-data.csv")
View(small)
small <- read_csv("~/Bio724/small-messy-data.csv",
comment = "#")
small <- read_csv("~/Bio724/small-messy-data.csv",
comment = "#") |>
rename(Gene = "...1")
small <- read_csv("~/Bio724/small-messy-data.csv",
comment = "#") |>
rename(Gene = "...1") |>
select(-"...4")
small |>
pivot_longer(cols = -Gene)
small |>
pivot_longer(cols = -Gene,
names_to = "Drug_Dosage_Rep",
values_to = "Expression")
small |>
pivot_longer(cols = -Gene,
names_to = "Drug_Dosage_Rep",
values_to = "Expression") |>
pivot_longer(cols = -Gene)
small |>
pivot_longer(cols = -Gene,
names_to = "Drug_Dosage_Rep",
values_to = "Expression")
small |>
pivot_longer(cols = -Gene,
names_to = "Drug_Dosage_Rep",
values_to = "Expression")  |>
separate_wider_delim(cols = Drug_Dosage_Rep,
delim = "_",
names = c("Drug", "Dosage", "Replicate"),
too_few = "align_start")
long_tidy <-
small |>
pivot_longer(cols = -Gene,
names_to = "Drug_Dosage_Rep",
values_to = "Expression")  |>
separate_wider_delim(cols = Drug_Dosage_Rep,
delim = "_",
names = c("Drug", "Dosage", "Replicate"),
too_few = "align_start")
View(long_tidy)
long_tidy |>
summary(mean_exp = mean(Expression, na.rm = TRUE))
long_tidy |>
summarize(mean_exp = mean(Expression, na.rm = TRUE))
long_tidy |>
group_by(Gene, Drug, Dosage)
summarize(mean_exp = mean(Expression, na.rm = TRUE))
long_tidy |>
group_by(Gene, Drug, Dosage) |>
summarize(mean_exp = mean(Expression, na.rm = TRUE))
tidy_summary <-
long_tidy |>
group_by(Gene, Drug, Dosage) |>
summarize(MeanExpression = mean(Expression, na.rm = TRUE))
View(tidy_summary)
tidy_summary |>
pivot_wider(names_from = Gene, values_from = MeanExpression)
corr_from_wide <-
tidy_summary |>
ungroup() |>  # ungroup important here
pivot_wider(names_from = Gene, values_from = Mean_Expression) |>
select(-c(Drug,Dosage,GeneF)) |>
cor(use = "pairwise.complete.obs" )
corr_from_wide <-
tidy_summary |>
ungroup() |>  # ungroup important here
pivot_wider(names_from = Gene, values_from = MeanExpression) |>
select(-c(Drug,Dosage,GeneF)) |>
cor(use = "pairwise.complete.obs" )
View(corr_from_wide)
write_csv(tidy_summary, "~/Bio724/small_tidy_summarized.csv")
library(tidyverse)
# load full weather data set and location metadata
wdata_full <- read_csv("weatherAUS.csv")
wlocs <- read_csv("weather_locations.csv")
View(wlocs)
# subset data from 6 locations and save
locs <- c("WaggaWagga", "Tuggeranong", "Ballarat", "Mildura", "Cairns", "MountGambier")
wdata6 <- filter(wdata_full, Location %in% locs)
write_csv(wdata6, "wdata_6.csv")
# separate the last column
wdata6_next <- select(wdata6, RainTomorrow)
wdata6 <- select(wdata6, -RainTomorrow)
# subset data from 1 location and save
wdata1 <- filter(wdata_full, Location == "Uluru")
write_csv(wdata1, "wdata_1.csv")
# separate the last column
wdata1_next <- select(wdata1, RainTomorrow)
wdata1 <- select(wdata1, -RainTomorrow)
# remove the full data set from memory
rm(wdata_full)
View(wdata6)
ggplot(wdata6, aes(x=MaxTemp, fill=Location)) +
geom_histogram(na.rm=TRUE, binwidth=1) +
facet_wrap(~ Location) +
theme_light()
ggplot(wdata6, aes(x=Humidity9am, y=Humidity3pm, color=Location)) +
geom_point(na.rm=TRUE, size=0.1, alpha=0.2) +
facet_wrap(~ Location) +
theme_light()
ggplot(wdata6, aes(x=RainToday, y=WindGustSpeed, color=RainToday)) +
geom_point(position='jitter', alpha=0.2, size=0.1, na.rm=TRUE) +
geom_violin(alpha=0.5, na.rm=TRUE) +
theme_light()
ggplot(wdata6, aes(x=RainToday, y=(Pressure9am - Pressure3pm), color=RainToday)) +
geom_point(position='jitter', alpha=0.2, size=0.1, na.rm=TRUE) +
geom_violin(alpha=0.5, na.rm=TRUE) +
facet_wrap(~ Location) +
theme_light()
View(wdata1)
# create tiny data frames
A <- c("a", "b", "c")                      # generate the columns
A2 <- c("a", "b", "d")
B <- c("t", "u", "v")
B2 <- c("t", "u", "w")
C <- c(1, 2, 3)
D <- c(3, 2, 1)
x <- data.frame(A = A, B = B, C = C)       # generate data frames containing the columnns
y <- data.frame(A = A2, B = B2, D = D)
x                                          # check your work!
y
View(x)
View(wdata6_next)
x
y
z <- tibble(E = c(1,2))
z
bind_cols(x,z)
?sample
bind_cols(wdata6, 1)
# simple row merge
bind_rows(x, y)
z
z <- tibble(E = c(1,2))
a
View(x)
View(x)
z <- tibble(A = 1, C = 2, B = 3)
z
row_bind(x,z)
bind_rows(x,z)
x
z <- tibble(A = "d", C = 2, B = "w")
bind_rows(x,z)
z <- tibble(A = "d", C = 2, D = "w")
bind_rows(x,z)
# create tiny data frames
A <- c("a", "b", "c")                      # generate the columns
A2 <- c("a", "b", "d")
B <- c("t", "u", "v")
B2 <- c("t", "u", "w")
C <- c(1, 2, 3)
D <- c(3, 2, 1)
x <- data.frame(A = A, B = B, C = C)       # generate data frames containing the columnns
y <- data.frame(A = A2, B = B2, D = D)
x
y
View(x)
View(y)
View(x)
# default join syntax is simple
left_join(x, y)                # note that R reports joining by A and B
# for a left join, order matters
left_join(y, x)                # result is different from the previous
View(x)
View(y)
View(x)
# create tiny data frames
A <- c("a", "b", "c", "e")                      # generate the columns
A2 <- c("a", "b", "d", "e")
B <- c("t", "u", "v", "r")
B2 <- c("t", "u", "w", "s")
C <- c(1, 2, 3, 4)
D <- c(3, 2, 1, 5)
x <- data.frame(A = A, B = B, C = C)       # generate data frames containing the columnns
y <- data.frame(A = A2, B = B2, D = D)
x
y
View(x)
View(y)
# default join syntax is simple
left_join(x, y)                # note that R reports joining by A and B
# for a left join, order matters
left_join(y, x)                # result is different from the previous
# default join syntax is simple
left_join(x, y)                # note that R reports joining by A and B
# default join syntax is simple
left_join(x, y, by = c("A","B"))                # note that R reports joining by A and B
# default join syntax is simple
left_join(x, y, by = join_by(A, B))                # note that R reports joining by A and B
# default join syntax is simple
left_join(x, y)                # note that R reports joining by A and B
# default join syntax is simple
left_join(x, y, by = join_by(A, B))                # note that R reports joining by A and B
# default join syntax is simple
left_join(x, y)                # note that R reports joining by A and B
# for a left join, order matters
left_join(y, x)                # result is different from the previous
# for a left join, order matters
full_join(x, y)                # result is different from the previous
# for a left join, order matters
inner_join(x, y)                # result is different from the previous
# for a left join, order matters
full_join(x, y)                # result is different from the previous
# inner join syntax
inner_join(wdata6, wlocs)
?nrow
