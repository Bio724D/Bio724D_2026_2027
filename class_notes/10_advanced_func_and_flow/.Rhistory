get_filename <- function(p) {
parts <- str_split_1(p, pattern="/")
parts[length(parts)]
}
get_author_and_title <- function(s) {
parts <- str_split_1(s, pattern="_")
list(first.name = parts[1],
last.name = parts[2],
title = parts[3] |>
str_replace(".txt","") |>
str_replace_all("-"," "))
}
path_to_auth_title <- function(p) {
results <-
p |>
get_filename() |>
get_author_and_title()
}
poem_files |> map(path_to_auth_title)
